# =============================================================================
# Enterprise AI Platform - Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust values for your local environment.
# .env is gitignored.  .env.example is committed to Git.
#
# All configuration values used by the application are defined here.
# Missing required values will cause the application to fail at startup.
# =============================================================================

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Enterprise AI Platform
APP_VERSION=0.1.0

# ---------------------------------------------------------------------------
# API / HTTP Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s
LOG_SILENCE_THIRD_PARTY=true

# ---------------------------------------------------------------------------
# Relational Database (SQLAlchemy)
# ---------------------------------------------------------------------------
DB_URL=sqlite+aiosqlite:///./data/dev.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
DB_TIMEOUT=30

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:latest
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Vector Database
# ---------------------------------------------------------------------------
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=
VECTOR_DB_INDEX_NAME=enterprise_ai
VECTOR_DB_DIMENSION=1536
VECTOR_DB_METRIC=cosine

# ---------------------------------------------------------------------------
# Graph Database
# ---------------------------------------------------------------------------
GRAPH_DB_PROVIDER=neo4j
GRAPH_DB_URL=bolt://localhost:7687
GRAPH_DB_USER=neo4j
GRAPH_DB_PASSWORD=password
GRAPH_DB_DATABASE=neo4j

# ---------------------------------------------------------------------------
# File / Object Storage
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/storage
STORAGE_BUCKET_NAME=enterprise-ai
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=

# ---------------------------------------------------------------------------
# Plugin System
# ---------------------------------------------------------------------------
PLUGIN_ENABLED=true
PLUGIN_DIRECTORIES=./plugins
PLUGIN_ALLOWED=[]
PLUGIN_BLOCKED=[]